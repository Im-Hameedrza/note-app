# Public configuration template. Copy with npm run setup; never commit .env.local.
APP_URL=http://localhost:3000

# Optional password-recovery email. Leave blank until you configure a provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional private database path. Default: db.json in the project root.
# Initialize a custom path from db.example.json before starting the application.
# DATABASE_FILE=

# Optional authenticated reverse-proxy mode; leave unset for local development.
# Use a random server-only secret of at least 32 characters and read the proxy
# trust contract in docs/application-guide.md before enabling this setting.
# AUTH_TRUSTED_PROXY_SECRET=
