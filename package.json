{
  "name": "note-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:auth": "node tests/integration/auth.integration.mjs",
    "test:theme": "node tests/browser/theme.browser.cjs",
    "test:settings": "node tests/browser/settings.browser.cjs",
    "test:qa": "node tests/browser/qa-regressions.browser.cjs",
    "setup": "node scripts/setup.mjs",
    "test:setup": "node --test tests/integration/setup.test.mjs",
    "test:production-storage": "node tests/integration/production-storage.test.mjs",
    "test:storage": "node --conditions=react-server --test tests/integration/blob-storage.test.mjs tests/integration/blob-services.test.mjs",
    "blob:db": "node --conditions=react-server --env-file-if-exists=.env.local scripts/blob-database.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@vercel/blob": "2.8.2",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "json-server": "^1.0.0-beta.15",
    "lucide-react": "^1.44.0",
    "next": "^16.3.8",
    "nodemailer": "^10.0.15",
    "query-string": "^9.5.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-hot-toast": "^2.6.1",
    "react-select": "^5.10.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "playwright": "1.63.0",
    "tailwindcss": "^4"
  }
}
